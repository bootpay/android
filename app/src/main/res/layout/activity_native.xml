<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context="kr.co.bootpay.android.NativeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 상품 이미지 영역 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="#F5F0FA">

                <ImageView
                    android:id="@+id/iv_product"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_product_bag"
                    android:scaleType="fitCenter" />

                <!-- SALE 배지 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="#FF5722"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="10% OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 뒤로가기 버튼 (선택) -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_share"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </FrameLayout>

            <!-- 상품 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 브랜드명 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BOOTPAY PREMIUM"
                    android:textColor="#9E9E9E"
                    android:textSize="13sp"
                    android:letterSpacing="0.1" />

                <!-- 상품명 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="프리미엄 레더 토트백"
                    android:textColor="#212121"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- 상품 설명 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="이탈리아산 최고급 천연 가죽으로 제작된 프리미엄 토트백입니다. 넉넉한 수납공간과 세련된 디자인으로 데일리백으로 완벽합니다."
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <!-- 구분선 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#EEEEEE" />

                <!-- 가격 정보 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10%"
                        android:textColor="#FF5722"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="89,000원"
                            android:textColor="#BDBDBD"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80,100원"
                            android:textColor="#212121"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 배송 정보 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#F8F8F8">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚚"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="무료배송"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오늘 주문시 내일 도착"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 개발자 옵션 (접이식) -->
                <LinearLayout
                    android:id="@+id/dev_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚙️ 개발자 옵션"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:text="PG사"
                                android:textColor="#757575"
                                android:textSize="11sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <Spinner
                                android:id="@+id/spinner_pg"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@android:drawable/btn_dropdown"
                                android:entries="@array/pg"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:text="결제수단"
                                android:textColor="#757575"
                                android:textSize="11sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <Spinner
                                android:id="@+id/spinner_method"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@android:drawable/btn_dropdown"
                                android:entries="@array/method"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 테스트용 금액 입력 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:text="테스트 금액:"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <EditText
                            android:id="@+id/edit_price"
                            android:layout_width="100dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="1000"
                            android:inputType="numberDecimal"
                            android:background="@android:drawable/edit_text"
                            android:padding="8dp"
                            android:textSize="13sp" />

                        <TextView
                            android:text="원"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:layout_marginStart="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edit_non_tax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:inputType="numberDecimal"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 하단 여백 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 하단 고정 구매 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_cart"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#F5F5F5"
            android:text="🛒"
            android:textSize="24sp"
            android:onClick="goTotalRequest" />

        <Button
            android:id="@+id/btn_purchase"
            android:text="구매하기"
            android:background="#4529e5"
            android:textColor="#FFFFFF"
            android:onClick="goRequest"
            android:layout_marginStart="12dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
